# ---------------------------------------------------------------------------
# Copy to .env and fill in.  `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Maps Data (RapidAPI) --------------------------------------------------
# Subscribe at https://rapidapi.com/alexanderxbx/api/maps-data and paste the key.
RAPIDAPI_KEY=

# Host + path are configurable on purpose: if the provider renames the
# endpoint, change it here instead of editing code.  Run `probe` after any
# change to confirm you still get results back.
MAPS_DATA_HOST=maps-data.p.rapidapi.com
MAPS_DATA_PATH=/searchmaps.php

# --- Ollama (local, free) --------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# --- Owner-name fallback (optional) ----------------------------------------
# Only used by `owners --fallback`: when a business's own website does not name
# an owner, Google "who owns X in Y" and let the local model read the results.
# Leave APIFY_TOKEN blank and the whole stage skips itself silently.
#
# Default backend is ScraperLink's Google SERP actor on Apify:
#   $0.0005 per search, no monthly fee, and Apify's free tier ($5/mo of
#   credits) covers ~10,000 lookups.
# It replaced OpenWeb Ninja, which cost ~$0.0025 per search AND $25/month --
# a standing charge is the wrong shape for a stage that only fires on
# leftovers. Neither returns Google's AI Overview; see gmscraper/websearch.py.
#
# Get a token at https://console.apify.com/settings/integrations
FALLBACK_SOURCE=apify
APIFY_TOKEN=
APIFY_SERP_ACTOR=scraperlink/google-search-results-serp-scraper

# Legacy backend. Only used with FALLBACK_SOURCE=openwebninja.
OPENWEBNINJA_KEY=
OPENWEBNINJA_HOST=real-time-web-search.p.rapidapi.com
OPENWEBNINJA_PATH=/search

# --- Cost accounting -------------------------------------------------------
# Which Maps Data plan you're on. Cost estimates are computed from the tier's
# included quota + overage rate, not a flat per-request price, because the same
# run costs $0 with quota left and real money without.
#
#   basic   $0/mo     1,000 req/mo   HARD LIMIT (no overage)
#   pro     $5/mo    30,000 req/mo   + $0.001
#   ultra  $25/mo   300,000 req/mo   + $0.0009
#   mega  $250/mo  6,000,000 req/mo  + $0.00005
#
# One request per (zip x category), so with the default 29,673-zip list:
#   pro    < 50,000 req/mo   ~1 category nationally, or many single states
#   ultra    50k-550,000     one national vertical (12-18 categories)
#   mega     > 550,000       two or more national verticals a month
#
# WARNING: only `basic` has a hard limit. pro/ultra/mega silently absorb an
# oversized run as overage -- `estimate` prints a "cheaper on ..." line when
# you are on the wrong tier for the job. Read it before confirming.

# Day of the month your quota resets. RapidAPI resets on your subscription
# anniversary, not the 1st -- set this to the day you subscribed so the
# "quota left" figure is right.
MAPS_QUOTA_RESET_DAY=1
MAPS_PLAN=ultra

# Optional: override the marginal per-request price (leave blank to use the
# plan's overage rate above).
PRICE_PER_REQUEST=
