# ---------------------------------------------------------------------------
# Copy to .env and fill in.  `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Maps Data (RapidAPI) --------------------------------------------------
# Subscribe at https://rapidapi.com/alexanderxbx/api/maps-data and paste the key.
RAPIDAPI_KEY=

# Host + path are configurable on purpose: if the provider renames the
# endpoint, change it here instead of editing code.  Run `probe` after any
# change to confirm you still get results back.
MAPS_DATA_HOST=maps-data.p.rapidapi.com
MAPS_DATA_PATH=/searchmaps.php

# --- LLM: which brain qualifies the leads -----------------------------------
# openai = any OpenAI-shaped endpoint (default). ollama = fully local.
#
# Cost for a NATIONAL vertical (~30k businesses) on gpt-5-nano: about $2, or
# ~$0.09 for a single state. That is 2-4% of what the Maps scrape costs for
# the same vertical, and it removes the local-hardware problem entirely --
# no 5 GB resident in RAM, no CPU contention, and stages parallelise freely.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# Reporting only -- USD per million tokens, used for the spend line each
# stage prints. Update if you change model or provider.
OPENAI_PRICE_IN=0.05
OPENAI_PRICE_OUT=0.40

# Same code drives any OpenAI-compatible server. Examples:
#
#   OpenRouter   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                OPENAI_MODEL=deepseek/deepseek-v4-flash
#                OPENAI_PRICE_IN=0.0896
#                OPENAI_PRICE_OUT=0.1792
#     Note this workload is ~94% input tokens, so a low output price moves
#     little: nano lands near $1.90 a national vertical and V4 Flash on
#     OpenRouter near $2.57. Pick on reliability, not on 67 cents.
#     OpenRouter serves one model from several providers and only some honour
#     json_schema, so the client sends provider.require_parameters=true to
#     avoid routing to one that downgrades to plain JSON mode. Every response
#     is structurally checked either way; watch the "schema repairs" count in
#     the spend line -- a nonzero number means the endpoint is not enforcing
#     the schema.
#
#   DeepSeek     OPENAI_BASE_URL=https://api.deepseek.com/v1
#                OPENAI_MODEL=deepseek-v4-flash
#   LM Studio    OPENAI_BASE_URL=http://localhost:1234/v1
#   GenieX (NPU) OPENAI_BASE_URL=http://localhost:8080/v1   # geniex serve

# --- Ollama (local fallback, free) ------------------------------------------
# Used when LLM_PROVIDER=ollama. Free and offline, but slow without a GPU.
OLLAMA_HOST=http://localhost:11434

# Pick this with `python -m gmscraper bench` -- it measures YOUR machine.
# Rough guide:
#   GPU (>=12 GB VRAM)   gemma4:12b     best quality
#   CPU only, 16 GB RAM  gemma4:e4b     ~4.7 GB, the edge-sized Gemma
#   CPU only, slow box   gemma4:e2b     ~3.1 GB, fastest
#   alternatives         qwen3.5:4b, phi4-mini
# A 12B on a CPU-only laptop is minutes per business, not seconds.
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=600

# Cap CPU threads so the machine stays usable while a stage runs. 0 lets
# Ollama grab most cores, which makes browsing miserable. On a 10-core
# Snapdragon X Plus, 4-6 leaves plenty for tabs and external displays and
# costs maybe 30-40% throughput on a job that runs unattended anyway.
OLLAMA_NUM_THREADS=0

# How long Ollama pins the model in RAM after the last call. Set "0" to free
# it the moment a stage finishes; "30m" to keep it warm between stages.
# The weights are several GB -- this is the RAM knob, not the model choice.
OLLAMA_KEEP_ALIVE=10m

# Characters of website text sent to the model. This is the biggest lever on
# CPU: the model must read every token before writing one, so a 12,000-char
# page is ~3,000 tokens of prefill (~2 minutes on a CPU-only 12B) versus ~625
# at 2,500 chars. Shorter is also usually *more* accurate -- less boilerplate
# for a small model to get distracted by.
LLM_MAX_EVIDENCE_CHARS=2500

# --- Owner-name fallback (optional) ----------------------------------------
# Only used by `owners --fallback`: when a business's own website does not name
# an owner, Google "who owns X in Y" and let the local model read the results.
# Leave APIFY_TOKEN blank and the whole stage skips itself silently.
#
# Default backend is ScraperLink's Google SERP actor on Apify:
#   $0.0005 per search, no monthly fee, and Apify's free tier ($5/mo of
#   credits) covers ~10,000 lookups.
# It replaced OpenWeb Ninja, which cost ~$0.0025 per search AND $25/month --
# a standing charge is the wrong shape for a stage that only fires on
# leftovers. Neither returns Google's AI Overview; see gmscraper/websearch.py.
#
# Get a token at https://console.apify.com/settings/integrations
FALLBACK_SOURCE=apify
APIFY_TOKEN=
APIFY_SERP_ACTOR=scraperlink/google-search-results-serp-scraper
# Website contact finder (apify_contact_crawl / parse_contacts_openai)
APIFY_CONTACT_ACTOR=automation-lab/website-contact-finder
APIFY_CONTENT_ACTOR=apify/website-content-crawler
APIFY_MAX_COST_USD=5.00

# Hard ceiling for paid Maps resolve_places / pipeline resolve stage.
MAPS_MAX_COST_USD=25.00

# Optional second Supabase project (e.g. permit_parcel / scrape_leads).
# LEADS_SUPABASE_URL=https://YOUR_LEADS_REF.supabase.co
# LEADS_SUPABASE_ANON_KEY=
# LEADS_SUPABASE_PROJECT_ID=

# Legacy backend. Only used with FALLBACK_SOURCE=openwebninja.
OPENWEBNINJA_KEY=
OPENWEBNINJA_HOST=real-time-web-search.p.rapidapi.com
OPENWEBNINJA_PATH=/search

# --- Cost accounting -------------------------------------------------------
# Which Maps Data plan you're on. Cost estimates are computed from the tier's
# included quota + overage rate, not a flat per-request price, because the same
# run costs $0 with quota left and real money without.
#
#   basic   $0/mo     1,000 req/mo   HARD LIMIT (no overage)
#   pro     $5/mo    30,000 req/mo   + $0.001
#   ultra  $25/mo   300,000 req/mo   + $0.0009
#   mega  $250/mo  6,000,000 req/mo  + $0.00005
#
# One request per (zip x category), so with the default 29,673-zip list:
#   pro    < 50,000 req/mo   ~1 category nationally, or many single states
#   ultra    50k-550,000     one national vertical (12-18 categories)
#   mega     > 550,000       two or more national verticals a month
#
# WARNING: only `basic` has a hard limit. pro/ultra/mega silently absorb an
# oversized run as overage -- `estimate` prints a "cheaper on ..." line when
# you are on the wrong tier for the job. Read it before confirming.

# Day of the month your quota resets. RapidAPI resets on your subscription
# anniversary, not the 1st -- set this to the day you subscribed so the
# "quota left" figure is right.
MAPS_QUOTA_RESET_DAY=1
MAPS_PLAN=ultra

# Optional: override the marginal per-request price (leave blank to use the
# plan's overage rate above).
PRICE_PER_REQUEST=

# --- Supabase (sync_to_supabase + enrich_waterfall → gc.*) -----------------
# Same project other lead MCPs use. Prefer the service role key for upserts.
# SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- Contact enrichment waterfall -----------------------------------------
# Order is fixed: getleads → AI Ark (people only) → LeadMagic → FullEnrich.
# AI Ark must NOT be used for email-to-profile reverse lookup.
# GETLEADS_API_KEY=
# GETLEADS_BASE_URL=https://app.getleads.io/api
# AI_ARK_API_KEY=
# LEADMAGIC_API_KEY=
# FULLENRICH_API_KEY=

# Optional override for the SQLite leads DB path (default: data/leads.db).
# LEADS_DB=
